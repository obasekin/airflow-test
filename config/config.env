# ============================================================
# Airflow Environment Configuration
# ============================================================

AIRFLOW_HOME=/opt/airflow
AIRFLOW_TIMEZONE=Europe/Istanbul

# Google Cloud Storage (GCS)
GCS_CONN_ID=google_cloud_default
GCS_BUCKET_NAME=arcanor-orion
GCS_MOBILITY_BASE_PATH=output/mobility
GCS_BLOCKLIST_BASE_PATH=control/druid/ingestion/blocklist/geohash
BLOCKLIST_FILENAME=ignore.csv

# Remote Logging & Ingestion Logs
LOG_BUCKET=arcanor-airflow-logs
LOG_PREFIX=logs/ingestion

# Druid Ingestion & Query
DRUID_CONN_ID=druid_default
DRUID_POLL_INTERVAL=60
DRUID_MAX_RETRIES=3

# JupyterHub Connection
JUPYTERHUB_CONN_ID=jupyterhub_default

# Email Notifications
NOTIFICATION_EMAILS=obasekin@arcanor.com, ucelik@arcanor.com
SMTP_CONN_ID=smtp_default
